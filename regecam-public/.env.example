# Plantilla de Variables de Entorno — Plataforma ReGeCAM (OPS)
# Inyecte estas variables en su servidor o plataforma de despliegue (ej. Cloudflare Pages / Vercel / Netlify / GitHub Actions)

ENV_SUPABASE_URL=https://<su-proyecto-supabase>.supabase.co
ENV_SUPABASE_ANON_KEY=<su-clave-anon-publica>
APP_VERSION=1.2.0
